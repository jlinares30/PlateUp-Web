---
import Layout from "../layouts/Layout.astro";
import BetaAccess from "../components/BetaAccess.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
import { useTranslations } from "../i18n/ui";
import { contentData } from "../i18n/content";

interface Props {
	lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const { coreFeatures, steps, faqs } = contentData[lang];

const privacyPath = lang === 'en' ? '/privacy' : '/es/privacy';
const homePath = lang === 'en' ? '/' : '/es';
const currentPath = Astro.url.pathname;
---

<Layout
	title={t('meta.title')}
	description={t('meta.description')}
	lang={lang}
>
	<!-- Navigation Bar -->
	<header class="navbar">
		<div class="container nav-container">
			<a href={homePath} class="brand">
				<img src="/logo.png" alt="PlateUp Logo" class="brand-logo" />
				<span class="brand-text"
					>Plate<span class="brand-accent">Up</span></span
				>
			</a>

			<nav class="nav-links">
				<a href="#features">{t('nav.features')}</a>
				<a href="#preview">{t('nav.preview')}</a>
				<a href="#how-it-works">{t('nav.howItWorks')}</a>
				<a href="#roadmap">{t('nav.roadmap')}</a>
				<a href="#faq">{t('nav.faq')}</a>
			</nav>

			<div class="nav-actions">
				<LanguagePicker currentLang={lang} currentPath={currentPath} />

				<a
					href="#beta-access"
					class="btn btn-primary btn-sm"
					id="nav-beta-btn"
				>
					<svg
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<polygon points="5 3 19 12 5 21 5 3"></polygon>
					</svg>
					{t('nav.tryBeta')}
				</a>
			</div>
		</div>
	</header>

	<main>
		<!-- Hero Section -->
		<section class="hero-section">
			<div class="hero-ambient-glow glow-1"></div>
			<div class="hero-ambient-glow glow-2"></div>

			<div class="container hero-container">
				<div class="hero-content">
					<div class="badge">
						<span class="badge-dot"></span>
						<span>{t('hero.badge')}</span>
					</div>

					<h1 class="hero-title">
						{t('hero.titleLine1')} <br />
						<span class="text-gradient">{t('hero.titleLine2')}</span>
					</h1>

					<p class="hero-description">
						{t('hero.description')}
					</p>

					<div class="hero-actions">
						<a
							href="#beta-access"
							class="btn btn-primary btn-lg"
							id="download-hero-btn"
						>
							<svg
								width="22"
								height="22"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.3"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<polygon points="5 3 19 12 5 21 5 3"></polygon>
							</svg>
							<span>{t('hero.cta')}</span>
						</a>
					</div>

					<div class="hero-stats">
						<div class="stat-item">
							<span class="stat-num">100%</span>
							<span class="stat-label">{t('hero.statFree')}</span>
						</div>
						<div class="stat-divider"></div>
						<div class="stat-item">
							<span class="stat-num">&lt; 5 min</span>
							<span class="stat-label">{t('hero.statPrep')}</span>
						</div>
						<div class="stat-divider"></div>
						<div class="stat-item">
							<span class="stat-num">30%</span>
							<span class="stat-label">{t('hero.statWaste')}</span>
						</div>
					</div>
				</div>

				<!-- App Showcase in Hero -->
				<div class="hero-mockup-wrapper" id="preview">
					<div class="phone-glow"></div>
					<div class="phone-frame">
						<div class="phone-notch">
							<div class="camera-lens"></div>
							<div class="speaker-grill"></div>
						</div>
						<div class="phone-screen">
							<div class="live-pill-tag">
								<span class="live-dot"></span>
								<span>{t('preview.liveDemo')}</span>
							</div>
							<img
								src="/plateup-demo.gif"
								alt="PlateUp Mobile App In Action - Live Demo"
								class="app-screenshot"
								loading="lazy"
							/>
						</div>

						<!-- Floating badges on the mockup -->
						<div class="floating-pill pill-top">
							<span class="pill-icon">🍲</span>
							<div>
								<div class="pill-title">
									{t('preview.pillRecipes')}
								</div>
								<div class="pill-sub">
									{t('preview.pillSmartMatch')}
								</div>
							</div>
						</div>

						<div class="floating-pill pill-bottom">
							<span class="pill-icon">🛒</span>
							<div>
								<div class="pill-title">{lang === 'en' ? 'Smart Shopping' : 'Lista Inteligente'}</div>
								<div class="pill-sub">
									{lang === 'en' ? 'Auto-organized by aisles' : 'Organizada por pasillos'}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Interactive Weekly Planner Highlight -->
		<section class="interactive-preview-section">
			<div class="container">
				<div class="planner-box glass-card">
					<div class="planner-header">
						<div>
							<span class="badge">{lang === 'en' ? 'Live Workflow' : 'Flujo en Vivo'}</span>
							<h3 class="planner-title">{t('preview.calTitle')}</h3>
						</div>
						<span class="badge-tag">{t('preview.calSubtitle')}</span>
					</div>

					<div class="planner-days-grid">
						<div class="day-col">
							<span class="day-name">{lang === 'en' ? 'Monday' : 'Lunes'}</span>
							<div class="meal-tag">🥑 {lang === 'en' ? 'Berry Protein Oats' : 'Avena con Frutos Rojos'}</div>
							<div class="meal-tag active">
								🍗 {lang === 'en' ? 'Lemon Herb Chicken' : 'Pollo al Limón con Hierbas'}
							</div>
							<div class="meal-tag">
								🫐 {lang === 'en' ? 'Protein Smoothie' : 'Batido Proteico'}
							</div>
						</div>
						<div class="day-col">
							<span class="day-name">{lang === 'en' ? 'Tuesday' : 'Martes'}</span>
							<div class="meal-tag">🥞 {lang === 'en' ? 'Oat Pancakes' : 'Pancakes de Avena'}</div>
							<div class="meal-tag active">
								🥗 {lang === 'en' ? 'Mediterranean Quinoa' : 'Bowl Mediterráneo'}
							</div>
							<div class="meal-tag">🥑 {lang === 'en' ? 'Veggie Wrap' : 'Wrap de Vegetales'}</div>
						</div>
						<div class="day-col">
							<span class="day-name">{lang === 'en' ? 'Wednesday' : 'Miércoles'}</span>
							<div class="meal-tag">🍳 {lang === 'en' ? 'Spinach Omelet' : 'Omelette de Espinaca'}</div>
							<div class="meal-tag active">
								🍣 {lang === 'en' ? 'Teriyaki Salmon Bowl' : 'Bowl de Salmón Teriyaki'}
							</div>
							<div class="meal-tag">🥣 {lang === 'en' ? 'Greek Yogurt & Chia' : 'Yogur Griego con Chía'}</div>
						</div>
						<div class="day-col">
							<span class="day-name">{lang === 'en' ? 'Thursday' : 'Jueves'}</span>
							<div class="meal-tag">🍓 {lang === 'en' ? 'Chia Pudding' : 'Pudín de Chía'}</div>
							<div class="meal-tag active">
								🌮 {lang === 'en' ? 'Healthy Turkey Tacos' : 'Tacos Saludables de Pavo'}
							</div>
							<div class="meal-tag">🍵 {lang === 'en' ? 'Green Detox Smoothie' : 'Smoothie Verde Detox'}</div>
						</div>
						<div class="day-col">
							<span class="day-name">{lang === 'en' ? 'Friday' : 'Viernes'}</span>
							<div class="meal-tag">
								🥖 {lang === 'en' ? 'Sourdough & Egg' : 'Tostada con Huevo Poché'}
							</div>
							<div class="meal-tag active">
								🍲 {lang === 'en' ? 'Creamy Lentil Curry' : 'Curry Suave de Lentejas'}
							</div>
							<div class="meal-tag">🍎 {lang === 'en' ? 'Apple Cinnamon Bowl' : 'Bowl de Manzana y Canela'}</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Grid Section -->
		<section class="features-section" id="features">
			<div class="container">
				<div class="section-header">
					<span class="badge">{t('features.badge')}</span>
					<h2>{t('features.title')}</h2>
					<p>{t('features.subtitle')}</p>
				</div>

				<div class="features-grid">
					{
						coreFeatures.map((feat) => (
							<div class="feature-card glass-card">
								<div class="feat-top">
									<div
										class="feature-icon-wrapper"
										style={`background: ${feat.badgeColor}; color: ${feat.textColor};`}
									>
										{feat.icon === "calendar" && (
											<svg
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<rect
													x="3"
													y="4"
													width="18"
													height="18"
													rx="2"
													ry="2"
												/>
												<line
													x1="16"
													y1="2"
													x2="16"
													y2="6"
												/>
												<line
													x1="8"
													y1="2"
													x2="8"
													y2="6"
												/>
												<line
													x1="3"
													y1="10"
													x2="21"
													y2="10"
												/>
											</svg>
										)}
										{feat.icon === "filter" && (
											<svg
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
											</svg>
										)}
										{feat.icon === "chef" && (
											<svg
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z" />
												<line
													x1="6"
													y1="17"
													x2="18"
													y2="17"
												/>
											</svg>
										)}
										{feat.icon === "cart" && (
											<svg
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<circle cx="8" cy="21" r="1" />
												<circle cx="19" cy="21" r="1" />
												<path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
											</svg>
										)}
										{feat.icon === "fridge" && (
											<svg
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<rect
													x="5"
													y="2"
													width="14"
													height="20"
													rx="2"
												/>
												<line
													x1="5"
													y1="10"
													x2="19"
													y2="10"
												/>
											</svg>
										)}
										{feat.icon === "lightning" && (
											<svg
												width="24"
												height="24"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
											</svg>
										)}
									</div>
									<span
										class="feat-tag"
										style={`color: ${feat.textColor};`}
									>
										{feat.tag}
									</span>
								</div>

								<h3 class="feat-card-title">{feat.title}</h3>
								<p class="feat-card-desc">{feat.description}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- How it Works Section -->
		<section class="how-section" id="how-it-works">
			<div class="container">
				<div class="section-header">
					<span class="badge">{t('howItWorks.badge')}</span>
					<h2>{t('howItWorks.title')}</h2>
					<p>{t('howItWorks.subtitle')}</p>
				</div>

				<div class="steps-grid">
					{
						steps.map((step) => (
							<div class="step-card glass-card">
								<span class="step-num">{step.number}</span>
								<h3 class="step-title">{step.title}</h3>
								<p class="step-desc">{step.desc}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Coming Soon: Web Version & AI Assistant -->
		<section class="roadmap-section" id="roadmap">
			<div class="container">
				<div class="section-header">
					<span class="badge">
						<span class="badge-dot"></span> {t('roadmap.badge')}
					</span>
					<h2>{t('roadmap.title')}</h2>
					<p>{t('roadmap.subtitle')}</p>
				</div>

				<div class="roadmap-grid">
					<!-- Card 1: Web App -->
					<div class="roadmap-card glass-card">
						<div class="roadmap-badge-row">
							<span class="tech-tag web-tag">{t('roadmap.card1Tech')}</span>
							<span class="status-pill">{t('roadmap.card1Status')}</span>
						</div>
						<div class="roadmap-icon-box">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
								<line x1="8" y1="21" x2="16" y2="21"></line>
								<line x1="12" y1="17" x2="12" y2="21"></line>
							</svg>
						</div>
						<h3 class="roadmap-card-title">{t('roadmap.card1Title')}</h3>
						<p class="roadmap-card-desc">
							{t('roadmap.card1Desc')}
						</p>
						<ul class="roadmap-bullets">
							<li>{t('roadmap.card1Bullet1')}</li>
							<li>{t('roadmap.card1Bullet2')}</li>
							<li>{t('roadmap.card1Bullet3')}</li>
						</ul>
					</div>

					<!-- Card 2: AI Voice Pantry -->
					<div class="roadmap-card glass-card highlight-card">
						<div class="roadmap-badge-row">
							<span class="tech-tag ai-tag">{t('roadmap.card2Tech')}</span>
							<span class="status-pill active-pill">{t('roadmap.card2Status')}</span>
						</div>
						<div class="roadmap-icon-box ai-icon">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
								<path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
								<line x1="12" y1="19" x2="12" y2="23"></line>
								<line x1="8" y1="23" x2="16" y2="23"></line>
							</svg>
						</div>
						<h3 class="roadmap-card-title">{t('roadmap.card2Title')}</h3>
						<p class="roadmap-card-desc">
							{t('roadmap.card2Desc')}
						</p>
						<div class="example-quote">
							<em>{t('roadmap.card2Quote')}</em>
							<span class="quote-arrow">{t('roadmap.card2Arrow')}</span>
						</div>
					</div>

					<!-- Card 3: AI Haul Photo Vision -->
					<div class="roadmap-card glass-card highlight-card">
						<div class="roadmap-badge-row">
							<span class="tech-tag vision-tag">{t('roadmap.card3Tech')}</span>
							<span class="status-pill active-pill">{t('roadmap.card3Status')}</span>
						</div>
						<div class="roadmap-icon-box vision-icon">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
								<circle cx="12" cy="13" r="4"></circle>
							</svg>
						</div>
						<h3 class="roadmap-card-title">{t('roadmap.card3Title')}</h3>
						<p class="roadmap-card-desc">
							{t('roadmap.card3Desc')}
						</p>
						<ul class="roadmap-bullets">
							<li>{t('roadmap.card3Bullet1')}</li>
							<li>{t('roadmap.card3Bullet2')}</li>
							<li>{t('roadmap.card3Bullet3')}</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- Beta Access Section -->
		<BetaAccess lang={lang} />

		<!-- Frequently Asked Questions -->
		<section class="faq-section" id="faq">
			<div class="container">
				<div class="section-header">
					<span class="badge">{t('faq.badge')}</span>
					<h2>{t('faq.title')}</h2>
					<p>{t('faq.subtitle')}</p>
				</div>

				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details class="faq-item glass-card">
								<summary class="faq-question">
									<span>{faq.q}</span>
									<svg
										class="faq-arrow"
										width="20"
										height="20"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<polyline points="6 9 12 15 18 9" />
									</svg>
								</summary>
								<div class="faq-answer">
									<p>{faq.a}</p>
								</div>
							</details>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="footer">
		<div class="container footer-grid">
			<div class="footer-brand-col">
				<div class="brand">
					<img
						src="/logo.png"
						alt="PlateUp Logo"
						class="brand-logo"
					/>
					<span class="brand-text"
						>Plate<span class="brand-accent">Up</span></span
					>
				</div>
				<p class="footer-tagline">
					{t('footer.tagline')}
				</p>
			</div>

			<div class="footer-links-col">
				<h4 class="footer-col-title">{t('footer.colNav')}</h4>
				<ul class="footer-list">
					<li><a href="#features">{t('nav.features')}</a></li>
					<li><a href="#preview">{t('nav.preview')}</a></li>
					<li><a href="#how-it-works">{t('nav.howItWorks')}</a></li>
					<li><a href="#faq">{t('nav.faq')}</a></li>
				</ul>
			</div>

			<div class="footer-links-col">
				<h4 class="footer-col-title">{t('footer.colApp')}</h4>
				<ul class="footer-list">
					<li>
						<a href="#beta-access">{t('footer.betaLink')}</a>
					</li>
					<li>
						<a
							href="https://github.com/jlinares30/PlateUp-app-mobile"
							target="_blank"
							rel="noopener noreferrer">{t('footer.githubLink')}</a
						>
					</li>
					<li><a href={privacyPath}>{t('footer.privacyLink')}</a></li>
				</ul>
			</div>
		</div>

		<div class="container footer-bottom">
			<p>
				&copy; {new Date().getFullYear()} {t('footer.copyright')}
			</p>
		</div>
	</footer>
</Layout>

<style>
	/* Header / Navigation */
	.navbar {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(9, 11, 14, 0.82);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
		padding: 0.9rem 0;
	}

	.nav-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
	}

	.brand-logo {
		width: 36px;
		height: 36px;
		object-fit: contain;
	}

	.brand-text {
		font-family: var(--font-heading);
		font-size: 1.45rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		color: #ffffff;
	}

	.brand-accent {
