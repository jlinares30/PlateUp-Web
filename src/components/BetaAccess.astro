---
import { distributionConfig } from "../config/distribution";

const { mode, closedTesting, publicRelease } = distributionConfig;
---

{
	mode === "closed_testing" ? (
		<section class="beta-section" id="beta-access">
			<div class="container">
				<div class="beta-card glass-card">
					<div class="beta-glow"></div>
					<div class="beta-container">
						<div class="section-header beta-header">
							<span class="badge">
								<span class="badge-dot"></span> Acceso Anticipado
							</span>
							<h2>Cómo unirse a la beta de PlateUp</h2>
							<p>
								PlateUp se encuentra actualmente en fase de pruebas cerradas (Closed Testing) en Google Play. Sigue estos dos sencillos pasos para probar la app e instalarla en tu dispositivo.
							</p>
						</div>

						<div class="steps-grid">
							<!-- Paso 1 -->
							<div class="step-card">
								<div class="step-badge">Paso 1</div>
								<div class="step-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
										<circle cx="9" cy="7" r="4"></circle>
										<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
										<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
									</svg>
								</div>
								<h3 class="step-title">Unirse a la comunidad de testers</h3>
								<p class="step-desc">
									Únete a nuestro grupo de testers para obtener acceso anticipado a PlateUp.
								</p>
								<div class="step-action">
									<a
										href={closedTesting.googleGroupUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="btn btn-secondary step-btn"
										id="btn-join-group"
									>
										<span>Unirme a la beta</span>
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
											<polyline points="15 3 21 3 21 9"></polyline>
											<line x1="10" y1="14" x2="21" y2="3"></line>
										</svg>
									</a>
								</div>
							</div>

							<!-- Paso 2 -->
							<div class="step-card">
								<div class="step-badge">Paso 2</div>
								<div class="step-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polygon points="5 3 19 12 5 21 5 3"></polygon>
									</svg>
								</div>
								<h3 class="step-title">Activar el acceso en Google Play</h3>
								<p class="step-desc">
									Una vez dentro del grupo, activa tu participación como tester e instala PlateUp directamente desde Google Play.
								</p>
								<div class="step-action">
									<a
										href={closedTesting.joinOnWebUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="btn btn-primary step-btn"
										id="btn-activate-play"
									>
										<span>Activar acceso en Google Play</span>
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
											<polyline points="15 3 21 3 21 9"></polyline>
											<line x1="10" y1="14" x2="21" y2="3"></line>
										</svg>
									</a>
								</div>
							</div>
						</div>

						<div class="beta-notice">
							<div class="notice-icon">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"></circle>
									<line x1="12" y1="16" x2="12" y2="12"></line>
									<line x1="12" y1="8" x2="12.01" y2="8"></line>
								</svg>
							</div>
							<p>
								<strong>Nota importante:</strong> Asegúrate de acceder con la misma cuenta de Google que utilizas en Google Play Store. El enlace del Paso 2 solo funcionará después de haberte unido al grupo del Paso 1.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	) : (
		<section class="download-banner-section" id="beta-access">
			<div class="container">
				<div class="download-banner glass-card">
					<div class="banner-glow"></div>
					<div class="banner-content">
						<span class="badge">
							<span class="badge-dot"></span> Oficial en Google Play
						</span>
						<h2 class="banner-title">
							Descarga PlateUp en Google Play
						</h2>
						<p class="banner-sub">
							Disponible oficialmente para tu dispositivo Android. Planifica tus comidas, descubre recetas y ahorra tiempo en tus compras.
						</p>

						<div class="banner-actions">
							<a
								href={publicRelease.googlePlayStoreUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-primary btn-lg"
							>
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
									<polygon points="5 3 19 12 5 21 5 3"></polygon>
								</svg>
								<span>Descargar en Google Play</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	)
}

<style>
	.beta-section {
		padding: var(--spacing-section) 0 3rem;
		position: relative;
		scroll-margin-top: 5rem;
	}

	.beta-card {
		position: relative;
		padding: 4rem 2.5rem;
		overflow: hidden;
		border: 1px solid rgba(16, 185, 129, 0.28);
		background: radial-gradient(
			circle at top center,
			rgba(16, 185, 129, 0.09) 0%,
			rgba(17, 20, 26, 0.95) 100%
		);
	}

	.beta-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 500px;
		height: 300px;
		background: rgba(16, 185, 129, 0.18);
		filter: blur(100px);
		border-radius: 50%;
		pointer-events: none;
	}

	.beta-container {
		position: relative;
		z-index: 1;
		max-width: 960px;
		margin: 0 auto;
	}

	.beta-header {
		margin-bottom: 3rem;
	}

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.step-card {
		position: relative;
		background: rgba(255, 255, 255, 0.025);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: var(--radius-lg);
		padding: 2.5rem 2rem 2rem;
		display: flex;
		flex-direction: column;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.step-card:hover {
		transform: translateY(-5px);
		border-color: rgba(52, 211, 153, 0.4);
		background: rgba(255, 255, 255, 0.04);
		box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.5), 0 0 25px rgba(16, 185, 129, 0.12);
	}

	.step-badge {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--color-primary-light);
		background: rgba(16, 185, 129, 0.12);
		border: 1px solid rgba(16, 185, 129, 0.3);
		padding: 0.25rem 0.65rem;
		border-radius: var(--radius-full);
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.step-icon {
		width: 54px;
		height: 54px;
		border-radius: var(--radius-md);
		background: rgba(16, 185, 129, 0.12);
		color: var(--color-primary-light);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(16, 185, 129, 0.22);
	}

	.step-title {
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--color-text-main);
		margin-bottom: 0.8rem;
		line-height: 1.3;
	}

	.step-desc {
		color: var(--color-text-muted);
		font-size: 0.98rem;
		line-height: 1.6;
		margin-bottom: 2rem;
		flex-grow: 1;
	}

	.step-action {
		margin-top: auto;
	}

	.step-btn {
		width: 100%;
		padding: 0.9rem 1.4rem;
	}

	.beta-notice {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		border-radius: var(--radius-md);
		background: rgba(245, 158, 11, 0.08);
		border: 1px solid rgba(245, 158, 11, 0.25);
		color: #fde68a;
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.notice-icon {
		flex-shrink: 0;
		color: #f59e0b;
		margin-top: 0.1rem;
	}

	.beta-notice strong {
		color: #ffffff;
	}

	@media (max-width: 640px) {
		.beta-card {
			padding: 2.5rem 1.25rem;
		}

		.step-card {
			padding: 2rem 1.25rem 1.5rem;
		}

		.beta-notice {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
